<Window x:Class="TimeTracker.InactivityWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Внимание"
        Width="480"
        Height="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#FFFEF3"
        Top="0"
        Left="0">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Text="&#x26A0; Внимание"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#B8860B"
                   Margin="0,0,0,12"/>

        <TextBlock x:Name="MessageText"
                   Grid.Row="1"
                   Text="Скоро отслеживание времени будет приостановлено.&#x0a;&#x0a;Вернитесь в целевое окно, чтобы продолжить."
                   FontSize="14"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Foreground="#333333"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="SwitchButton"
                    Content="Переключиться"
                    Width="120"
                    Height="28"
                    Margin="0,0,8,0"
                    Click="OnSwitchClick"/>
            <ComboBox x:Name="SnoozeCombo"
                      Width="95"
                      Height="28"
                      VerticalContentAlignment="Center"
                      Margin="0,0,8,0">
                <ComboBoxItem Content="5 минут" Tag="5" IsSelected="True"/>
                <ComboBoxItem Content="10 минут" Tag="10"/>
                <ComboBoxItem Content="15 минут" Tag="15"/>
                <ComboBoxItem Content="30 минут" Tag="30"/>
                <ComboBoxItem Content="1 час" Tag="60"/>
            </ComboBox>
            <Button Content="Отложить"
                    Width="90"
                    Height="28"
                    Margin="0,0,8,0"
                    Click="OnSnoozeClick"/>
            <Button Content="OK"
                    Width="80"
                    Height="28"
                    Click="OnOkClick"/>
        </StackPanel>
    </Grid>
</Window>
