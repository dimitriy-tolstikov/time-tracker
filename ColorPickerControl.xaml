<UserControl x:Class="TimeTracker.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="White" BorderBrush="#999999" BorderThickness="1" Padding="10" Width="240">
        <StackPanel>
            <Rectangle Height="26" Margin="0,0,0,8" Stroke="#999999"
                       Fill="{Binding ColorHex, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Тон:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <Slider x:Name="HueSlider" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="360"
                        ValueChanged="Slider_ValueChanged" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Насыщ.:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <Slider x:Name="SaturationSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100"
                        ValueChanged="Slider_ValueChanged" Margin="0,0,0,4"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Яркость:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                <Slider x:Name="ValueSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100"
                        ValueChanged="Slider_ValueChanged" Margin="0,0,0,4"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                <TextBlock Text="Hex:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Width="90" Text="{Binding ColorHex, RelativeSource={RelativeSource AncestorType=UserControl},
                                             UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>

            <ItemsControl x:Name="Palette">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="22" Height="22" Margin="0,0,4,4" Padding="0"
                                BorderBrush="#666666" Tag="{Binding}"
                                Click="PaletteColor_Click">
                            <Rectangle Fill="{Binding}" Stretch="Fill"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
