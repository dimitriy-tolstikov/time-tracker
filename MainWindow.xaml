<Window x:Class="TimeTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:TimeTracker.Models"
        xmlns:converters="clr-namespace:TimeTracker.Converters"
        Title="Time Tracker" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        MinWidth="900" MinHeight="550"
        Icon="clock.ico">
    <Window.Resources>
        <converters:MinutesToHeightConverter x:Key="MinutesToHeight" MaxHeight="150" MaxMinutes="60"/>

        <DataTemplate DataType="{x:Type models:HourlyStat}">
            <Grid Width="28" Margin="1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="170"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Canvas Grid.Row="0" Height="150" VerticalAlignment="Bottom" Background="Transparent">
                    <Rectangle Fill="LightGray" Width="24" Canvas.Bottom="0"
                               Height="{Binding IdleMinutes, Converter={StaticResource MinutesToHeight}}"/>
                    <Rectangle Fill="ForestGreen" Width="24"
                               Canvas.Bottom="{Binding IdleMinutes, Converter={StaticResource MinutesToHeight}}"
                               Height="{Binding WorkMinutes, Converter={StaticResource MinutesToHeight}}"/>
                </Canvas>

                <TextBlock Grid.Row="1" Text="{Binding HourLabel}" HorizontalAlignment="Center" FontSize="8" Margin="0,2,0,0"/>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:DaySummary}">
            <TextBlock Text="{Binding DisplayText}" FontSize="12"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" FontSize="24" FontWeight="Bold" Text="{Binding CurrentTimeText}" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Отслеживаемое время: " FontSize="16" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding TrackedTimeText}" FontSize="16" FontWeight="Bold" Foreground="DarkGreen" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding LastSavedText}" FontSize="12" Foreground="Gray" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Статус: " FontSize="12" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="DarkBlue" VerticalAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{Binding SetWindowButtonText}" Command="{Binding SetWindowCommand}" Padding="15,6" Margin="0,0,10,0"/>
            <Button Content="Сбросить время" Command="{Binding ResetCommand}" Padding="15,6"/>
        </StackPanel>

        <GroupBox Grid.Row="4" Grid.Column="0" Header="{Binding SelectedDayHeaderText}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding SelectedDayHourlyStats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </GroupBox>

        <GroupBox Grid.Row="5" Grid.Column="0" Header="Журнал действий" Margin="0,10,0,0">
            <ListView ItemsSource="{Binding Actions}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Время" DisplayMemberBinding="{Binding TimeFormatted}" Width="120"/>
                        <GridViewColumn Header="Интервал с пред." DisplayMemberBinding="{Binding IntervalText}" Width="120"/>
                        <GridViewColumn Header="Засчитано" DisplayMemberBinding="{Binding IsCounted}" Width="80"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </GroupBox>

        <GroupBox Grid.Row="0" Grid.Column="1" Grid.RowSpan="6" Header="История по дням" Margin="15,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Content="Сегодня" Command="{Binding ShowTodayCommand}" Padding="10,5" Margin="0,0,0,10"/>

                <ListBox Grid.Row="1" ItemsSource="{Binding AvailableDays}" SelectedItem="{Binding SelectedDay}"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
