<Window x:Class="TimeTracker.InactivityWarningWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Внимание"
        Width="420"
        Height="220"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#FFFEF3"
        Top="0"
        Left="0">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="&#x26A0; Внимание"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#B8860B"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1"
                   Text="Скоро отслеживание времени будет приостановлено.&#x0a;&#x0a;Вернитесь в целевое окно, чтобы продолжить."
                   FontSize="14"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Foreground="#333333"/>

        <Button Grid.Row="2"
                Content="OK"
                Width="80"
                Height="28"
                HorizontalAlignment="Right"
                Click="OnOkClick"
                Margin="0,15,0,0"/>
    </Grid>
</Window>
