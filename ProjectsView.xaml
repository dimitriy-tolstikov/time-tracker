<UserControl x:Class="TimeTracker.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TimeTracker">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список проектов -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="12" Height="12" Fill="{Binding Color}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Добавить" Command="{Binding AddProjectCommand}" Padding="10,5" Margin="0,0,5,0"/>
                <Button Content="Удалить" Command="{Binding DeleteProjectCommand}" Padding="10,5"/>
            </StackPanel>
        </Grid>

        <!-- Редактирование проекта, его уведомлений и правил -->
        <Grid Grid.Column="1" Margin="15,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="Проект">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBox Text="{Binding SelectedProject.Name, UpdateSourceTrigger=PropertyChanged}" MinWidth="200" HorizontalAlignment="Left"/>
                        <Button Content="Сохранить" Command="{Binding SaveProjectCommand}" Padding="12,4" Margin="15,0,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Цвет:" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBox Text="{Binding SelectedProject.Color, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <Button x:Name="ColorButton" Padding="4,2" Margin="8,0,0,0" Click="ColorButton_Click"
                                ToolTip="Выбрать цвет">
                            <Rectangle Width="30" Height="14" Fill="{Binding SelectedProject.Color}"/>
                        </Button>
                        <Popup x:Name="ColorPopup" PlacementTarget="{Binding ElementName=ColorButton}"
                               Placement="Bottom" StaysOpen="False">
                            <local:ColorPickerControl x:Name="ColorPicker"
                                                      ColorHex="{Binding SelectedProject.Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Popup>
                    </StackPanel>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="Уведомления" Margin="0,10,0,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" Height="80" ItemsSource="{Binding SelectedProjectNotifications}"
                             SelectedItem="{Binding SelectedNotification}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,6,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="White"/>
                                                <Setter Property="Stroke" Value="#AAAAAA"/>
                                                <Setter Property="StrokeThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity, Mode=OneWay}" Value="warning">
                                                        <Setter Property="Fill" Value="#FFC107"/>
                                                        <Setter Property="Stroke" Value="#B8860B"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity, Mode=OneWay}" Value="critical">
                                                        <Setter Property="Fill" Value="#E53935"/>
                                                        <Setter Property="Stroke" Value="#B71C1C"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding DisplayText, Mode=OneWay}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <ComboBox ItemsSource="{Binding NotificationTypes}"
                                      SelectedValue="{Binding SelectedNotification.Type}"
                                      SelectedValuePath="Value" DisplayMemberPath="Display"
                                      Width="130" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding SeverityLevels}"
                                      SelectedValue="{Binding SelectedNotification.Severity}"
                                      SelectedValuePath="Value" DisplayMemberPath="Display"
                                      Width="90" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding SelectedNotification.ThresholdMinutesPart, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <TextBlock Text="мин" VerticalAlignment="Center" Margin="4,0,8,0"/>
                            <TextBox Text="{Binding SelectedNotification.ThresholdSecondsPart, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <TextBlock Text="сек" VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Button Content="Добавить уведомление" Command="{Binding AddNotificationCommand}" Padding="10,5" Margin="0,0,5,0"/>
                            <Button Content="Сохранить уведомление" Command="{Binding SaveNotificationCommand}" Padding="10,5" Margin="0,0,5,0"/>
                            <Button Content="Удалить уведомление" Command="{Binding DeleteNotificationCommand}" Padding="10,5"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="Правила классификации" Margin="0,10,0,0">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0" ItemsSource="{Binding SelectedProjectRules}" SelectedItem="{Binding SelectedRule}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Run.Text по умолчанию TwoWay — без Mode=OneWay read-only свойства роняют рендер. -->
                                <TextBlock>
                                    <Run Text="{Binding RuleTypeDisplay, Mode=OneWay}"/>
                                    <Run Text=": "/>
                                    <Run Text="{Binding Pattern, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text=" (приоритет "/>
                                    <Run Text="{Binding Priority, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="1" Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                            <ComboBox ItemsSource="{Binding RuleTypes}"
                                      SelectedValue="{Binding SelectedRule.RuleType}"
                                      SelectedValuePath="Value" DisplayMemberPath="Display"
                                      Width="190" Margin="0,0,5,0"/>
                            <TextBox Text="{Binding SelectedRule.Pattern, UpdateSourceTrigger=PropertyChanged}"
                                     Width="230" Margin="0,0,5,0" ToolTip="Подстрока или regex"/>
                            <CheckBox Content="regex" IsChecked="{Binding SelectedRule.IsRegex}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Приоритет:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox Text="{Binding SelectedRule.Priority, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <Button Content="Добавить правило" Command="{Binding AddRuleCommand}" Padding="10,5" Margin="0,0,5,0"/>
                            <Button Content="Сохранить правило" Command="{Binding SaveRuleCommand}" Padding="10,5" Margin="0,0,5,0"/>
                            <Button Content="Удалить правило" Command="{Binding DeleteRuleCommand}" Padding="10,5"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
